---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import content from '../data/content.json';
import images from '../data/images.json';
import {siteConfig} from '../data/siteConfig';
const slug='contact';
const home0 = content.pages['/'];
const pg = {
  title: 'Contact Hudson Hydro Jetting Pros | Hudson, OH',
  desc: 'Call or send a request to Hudson Hydro Jetting Pros about a slow drain, repeat clog or sewer line in Hudson, Ohio.',
  h1: 'Contact Hudson Hydro Jetting Pros',
  heroP: 'Tell us which drain is slow or backing up and where the property is. Calling is the fastest way to reach us, or send the form and we will follow up.',
  bc: 'Contact',
  ld: [],
  sections: [],
  formHtml: String(home0.formHtml).replace('value="Homepage"', 'value="contact"').replace('value="Home"', 'value="contact"'),
};
const home=false;const legal=false;
const fill=s=>String(s??'').replace(/\{\{PHONE_DISPLAY\}\}/g,siteConfig.phoneDisplay).replace(/\{\{PHONE_HREF\}\}/g,siteConfig.phoneHref).replace(/\{\{BRAND\}\}/g,siteConfig.brand);
const url=siteConfig.origin+(home?'/':`/${slug}/`);const figs=images[slug]||{};
---
<Base title={pg.title} desc={pg.desc} canonical={url} ld={[...pg.ld,JSON.stringify({"@context":"https://schema.org","@type":"Organization",name:siteConfig.brand,url:siteConfig.origin,telephone:siteConfig.phoneHref,areaServed:{"@type":"City",name:"Hudson, Ohio"}})]} modified={siteConfig.lastModified}>
<Chrome part="header" fill={fill}/>
<main id="main">
<section class={`hero ${home?'hero-home':'hero-page'}`}>
{!legal && <><img class="hero-bg" src={siteConfig.heroImage} alt="Water spray from a hydro jetting nozzle" width="1200" height="896" fetchpriority="high"/><div class="hero-shade"></div></>}
<div class="hero-in"><div class="hero-copy"><h1>{pg.h1}</h1><p class="hero-p" set:html={fill(pg.heroP)}/><div class="hero-actions"><a class="btn btn-primary" href={'tel:'+siteConfig.phoneHref}>Call {siteConfig.phoneDisplay}</a><a class="btn btn-ghost" href="#contact">Request a Call</a></div></div>
<div class="form-card" id="contact"><h2>Request a call</h2><Fragment set:html={fill(pg.formHtml)}/></div></div>
</section>
{pg.intro&&<section class="sec sec-lede"><div class="sec-in prose"><p set:html={fill(pg.intro)}/></div></section>}
{pg.sections.map((s,i)=><section class={`sec sec-${s.kind} sec-${i%2?'b':'a'}`}><div class="sec-in"><Fragment set:html={fill(s.html)}/>{figs[String(i)]&&<figure class="sec-fig"><img src={figs[String(i)].src} alt={figs[String(i)].alt} width="1200" height="896" loading="lazy"/></figure>}</div></section>)}
{pg.faq&&<section class="sec sec-faq"><div class="sec-in"><h2>Common questions</h2><div class="faq">{pg.faq.map(f=><details><summary set:html={fill(f.q)}/><p set:html={fill(f.a)}/></details>)}</div></div></section>}
</main><Chrome part="footer" fill={fill}/>
</Base>
